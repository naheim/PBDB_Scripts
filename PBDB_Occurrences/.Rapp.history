if(major.phyla.only == TRUE) {#
	all.phyla <- phyla.call$taxon_name[phyla.call$n_occs >= 2000 & phyla.call$taxon_name != "Mollusca"]#
} else {#
	all.phyla <- phyla.call$taxon_name[phyla.call$n_occs > 0 & phyla.call$taxon_name != "Mollusca"]#
}#
all.phyla <- c(all.phyla, c("Bivalvia","Gastropoda","Mollusca,^Gastropoda,^Bivalvia")) # mollusks have been split to prevent timing out
all.phyla
params <- paste(c(#
     "pres=regular", # only body fossils#
     "taxon_status=accepted",#
     "idreso=lump_genus", # lump mult. species of the same genus in each collection into a single occurrence#
     "show=loc,paleoloc,class,abund,coords,lith,ecospace,env,ent,entname"#
), collapse="&")#
#
# Because of the size of the request, it often times out#
# to solve this I am requesting each phylum separately and by geological Era#
pbdb.occs <- list()#
k <- 1
# Because of the size of the request, it often times out#
# to solve this I am requesting each phylum separately and by geological Era#
pbdb.occs <- list()#
k <- 1#
for(i in all.phyla) {#
     for(j in c("Neoproterozoic","Paleozoic","Mesozoic","Cenozoic")) {#
          final.url <- paste0(api.base, paste0("base_name=",i,"&interval=",j,"&"), params)#
          pbdb.call <- read.csv(file=URLencode(final.url))#
          pbdb.occs[[k]] <- pbdb.call#
          k <- k + 1#
          print(paste(i, j, sep=" - ")) # this is to keep track of loop progress#
     }#
}
