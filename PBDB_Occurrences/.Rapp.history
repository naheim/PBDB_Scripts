### Get Occurrences#
phyla.url <- "https://paleobiodb.org/data1.2/taxa/list.csv?base_name=Animalia&rank=phylum&taxon_status=accepted&pres=regular&order=n_occs"#
phyla.call <- read.csv(file=URLencode(phyla.url))#
#
if(major.phyla.only == TRUE) {#
	all.phyla <- phyla.call$taxon_name[phyla.call$n_occs >= 2000 & taxon_name != "Mollusca"]#
} else {#
	all.phyla <- phyla.call$taxon_name[phyla.call$n_occs > 0 & taxon_name != "Mollusca"]#
}#
all.phyla <- c(all.phyla, c("Bivalvia","Gastropoda","Mollusca,^Gastropoda,^Bivalvia")) # mollusks have been split to prevent timing out#
#
